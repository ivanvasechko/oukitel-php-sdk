{
  "name": "ivanvasechko/oukitel-php-sdk",
  "description": "Unofficial framework-agnostic Oukitel power-station SDK with typed telemetry and portable PSR integrations.",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "authors": [
    {
      "name": "Ivan Vasechko",
      "homepage": "https://github.com/ivanvasechko"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "php-http/discovery": "^1.19",
    "psr/clock": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^2.0 || ^3.0",
    "psr/simple-cache": "^2.0 || ^3.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^8.3",
    "laravel/pint": "^1.29.3",
    "nyholm/psr7": "^1.8",
    "pestphp/pest": "^2.36 || ^3.0 || ^4.0 || ^5.0",
    "php-http/mock-client": "^1.6",
    "phpstan/phpstan": "^2.1",
    "symfony/cache": "^7.4 || ^8.0",
    "symfony/http-client": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "IvanVasechko\\Oukitel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IvanVasechko\\Oukitel\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "guzzlehttp/guzzle": "PSR-18 HTTP transport with automatic timeout configuration.",
    "symfony/http-client": "Alternative PSR-18 HTTP transport."
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "pest --coverage --min=90",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "pint": "pint"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}
